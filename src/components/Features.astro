---
import FeatureCard from './FeatureCard.astro';
---

<section id="features" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-16">
      <h2 class="font-display italic text-3xl sm:text-4xl md:text-5xl mb-4 animate">
        Alles was du brauchst.
        <span class="text-gradient">Nichts was dich stört.</span>
      </h2>
      <p class="text-text-secondary max-w-xl mx-auto animate">
        Von Live-Daten über KI-Empfehlungen bis zum Geschmacks-Feedback —
        alles, was zwischen dir und dem perfekten Espresso steht.
      </p>
    </div>

    <!-- Feature grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="animate stagger-1">
        <FeatureCard
          icon="&#127919;"
          title="Dein Dial-In-Coach"
          description="Nach jedem Shot eine konkrete Empfehlung: Mahle feiner — 8.0 → 7.0. Ein Parameter pro Shot, bis du im Sweet-Spot bist."
          accentColor="primary"
        />
      </div>

      <div class="animate stagger-2">
        <FeatureCard
          icon="&#9878;"
          title="Live-Daten per Bluetooth"
          description="Verbinde deine Acaia-Waage: Gewicht, Flow, Druck und Temperatur laufen live ins Chart — Stopp auf den Gramm genau."
          accentColor="accent"
        />
      </div>

      <div class="animate stagger-3">
        <FeatureCard
          icon="&#129517;"
          title="Geschmack statt Zahlen"
          description="Sauer? Bitter? Zu stark? Tippe dein Geschmacksurteil auf den Kompass — BrewMind übersetzt es in Brühparameter."
          accentColor="warning"
        />
      </div>

      <div class="animate stagger-4">
        <FeatureCard
          icon="&#128200;"
          title="Trends & Verlauf"
          description="Jeder Shot zahlt ein: 14-Tage-Trend, Shot-Serien und deine Konvergenz Richtung Sweet-Spot auf einen Blick."
          accentColor="success"
        />
      </div>
    </div>
  </div>
</section>
