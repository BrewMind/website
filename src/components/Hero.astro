---
import { Image } from 'astro:assets';
import cockpit from '../assets/screens/cockpit.png';
---

<section id="hero" class="relative min-h-screen flex items-center overflow-hidden pt-28 pb-20">
  <!-- Warme Tiefe nach oben, damit der Header nicht auf der Flaeche klebt -->
  <div class="absolute inset-0 bg-gradient-to-b from-bg-deep via-bg to-bg"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[min(900px,120vw)] h-[min(600px,80vh)] rounded-full bg-accent/[0.06] blur-3xl"></div>

  <!--
    Signatur der Seite: die Shot-Kurve, die die App waehrend der Aufnahme
    aufbaut — Gewicht in Bernstein, Flow in Blau, dieselben zwei Serien wie
    im Shot-Detail. Sie zeichnet sich einmal und bleibt stehen.
  -->
  <svg
    class="absolute inset-x-0 bottom-0 w-full h-[55vh] opacity-[0.22] pointer-events-none [mask-image:linear-gradient(to_right,transparent,black_18%,black_82%,transparent)]"
    viewBox="0 0 400 200"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      d="M0,190 C20,190 30,188 40,185 C80,175 120,130 200,90 C280,50 340,35 380,30 L400,28"
      fill="none"
      stroke="var(--color-weight)"
      stroke-width="1.5"
      vector-effect="non-scaling-stroke"
      class="draw-line"
      style="--len: 520"
    />
    <path
      d="M0,192 C15,190 25,182 40,152 C50,132 60,102 75,97 C110,92 150,94 200,90 C240,88 270,97 310,122 C340,142 360,162 380,172 L400,176"
      fill="none"
      stroke="var(--color-flow)"
      stroke-width="1.5"
      vector-effect="non-scaling-stroke"
      class="draw-line draw-line-delayed"
      style="--len: 520"
    />
  </svg>

  <div class="relative z-10 w-full max-w-6xl mx-auto px-6">
    <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-14 lg:gap-12 items-center">
      <!-- Text -->
      <div class="text-center lg:text-left">
        <p class="label mb-5 animate">Siebträger · Lokal · Ohne Account</p>

        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl leading-[1.1] text-balance mb-6 animate">
          Espresso einstellen,<br class="hidden sm:block" />
          <span class="text-accent">ohne zu raten.</span>
        </h1>

        <p class="text-lg text-ink-2 max-w-xl mx-auto lg:mx-0 mb-9 animate leading-relaxed">
          BrewMind nimmt jeden Shot auf, live über die Bluetooth-Waage oder
          per Timer, und merkt sich pro Bohne, welche Einstellung funktioniert
          hat. Damit die nächste Tüte nicht wieder 500 g Einstellkaffee kostet.
        </p>

        <div class="flex flex-col sm:flex-row items-center lg:justify-start justify-center gap-4 mb-10 animate">
          <div role="img" aria-label="App Store: bald verfügbar" class="flex items-center gap-3 px-5 py-3 rounded-xl bg-surface border border-border cursor-default">
            <svg aria-hidden="true" class="w-7 h-7 text-ink-3" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            <div aria-hidden="true" class="text-left">
              <div class="text-xs text-ink-3">Bald im</div>
              <div class="text-sm font-semibold text-ink">App Store</div>
            </div>
          </div>

          <a href="#features" class="px-5 py-3 rounded-xl text-sm font-medium text-accent hover:text-accent-pressed transition-colors">
            Was die App kann &darr;
          </a>
        </div>

        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-surface border border-border animate">
          <span class="w-2 h-2 rounded-full bg-ok"></span>
          <span class="text-sm text-ink-2">In geschlossener Beta</span>
        </div>
      </div>

      <!-- Geraet -->
      <div class="relative mx-auto w-full max-w-[280px] sm:max-w-[300px] animate-scale">
        <div class="aspect-[9/19.5] rounded-[2.75rem] border-[10px] border-surface-2 bg-surface overflow-hidden glow-accent">
          <Image
            src={cockpit}
            alt="Das Bohnen-Cockpit von BrewMind: aktive Bohne, Tag nach Röstung und die zuletzt gefahrene Einstellung"
            width={780}
            format="webp"
            class="w-full h-full object-cover object-top"
          />
        </div>
      </div>
    </div>
  </div>
</section>
