---
const currentYear = new Date().getFullYear();
---

<footer class="py-12 px-6 border-t border-border bg-bg-deep">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Logo + Copyright -->
      <div class="flex items-center gap-3">
        <!--
          Signet inline wie im Header, nicht als <img src="/logo-mark.svg">:
          auf einem echten iPhone fiel die Maske im <img> weg und uebrig blieb
          ein bernsteinfarbenes Quadrat. Mask-ID eindeutig je Seite.
        -->
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 100 100" width="24" height="24" role="img" aria-label="BrewMind">
          <mask id="footer-mark-cut">
            <circle cx="50" cy="50" r="36" fill="#fff" />
            <path
              d="M10,76 C28,75 34,68 44,55 C54,42 64,28 90,26"
              fill="none"
              stroke="#000"
              stroke-width="12"
              stroke-linecap="butt"
            />
          </mask>
          <rect width="100" height="100" fill="var(--color-accent)" mask="url(#footer-mark-cut)" />
        </svg>
        <span class="text-sm text-ink-2">
          &copy; {currentYear} BrewMind. Alle Rechte vorbehalten.
        </span>
      </div>

      <!-- Links -->
      <div class="flex flex-col items-center md:flex-row md:items-center gap-3 md:gap-6">
        <!-- Legal Links -->
        <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
          <a href="/support/" class="text-sm text-ink-2 hover:text-ink transition-colors">Support</a>
          <a href="/qr/" class="text-sm text-ink-2 hover:text-ink transition-colors">QR-Rezept</a>
          <a href="/impressum/" class="text-sm text-ink-2 hover:text-ink transition-colors">Impressum</a>
          <a href="/datenschutz/" class="text-sm text-ink-2 hover:text-ink transition-colors">Datenschutz</a>
          <a href="/loeschen/" class="text-sm text-ink-2 hover:text-ink transition-colors">Daten löschen</a>
          <a href="/privacy/" class="text-sm text-ink-2 hover:text-ink transition-colors">Privacy</a>
          <a href="/terms/" class="text-sm text-ink-2 hover:text-ink transition-colors">Terms</a>
        </div>
        <!-- GitHub -->
        <a href="https://github.com/BrewMind" target="_blank" rel="noopener noreferrer" class="text-sm text-ink-2 hover:text-ink transition-colors">
          GitHub
        </a>
      </div>
    </div>
  </div>
</footer>
