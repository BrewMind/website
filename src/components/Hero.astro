---
import { Image } from 'astro:assets';
import cockpit from '../assets/screens/cockpit.png';
import { TESTFLIGHT_URL } from '../data/links';
---

<section id="hero" class="relative min-h-screen flex items-center overflow-hidden pt-28 pb-20">
  <!-- Warme Tiefe nach oben, damit der Header nicht auf der Flaeche klebt -->
  <div class="absolute inset-0 bg-gradient-to-b from-bg-deep via-bg to-bg"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[min(900px,120vw)] h-[min(600px,80vh)] rounded-full bg-accent/[0.06] blur-3xl"></div>

  <!--
    Signatur der Seite: die Shot-Kurve, die die App waehrend der Aufnahme
    aufbaut — Gewicht in Bernstein, Flow in Blau, dieselben zwei Serien wie
    im Shot-Detail. Sie zeichnet sich einmal und bleibt stehen.
  -->
  <svg
    class="absolute inset-x-0 bottom-0 w-full h-[55vh] opacity-[0.22] pointer-events-none [mask-image:linear-gradient(to_right,transparent,black_18%,black_82%,transparent)]"
    viewBox="0 0 400 200"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      d="M0,190 C20,190 30,188 40,185 C80,175 120,130 200,90 C280,50 340,35 380,30 L400,28"
      fill="none"
      stroke="var(--color-weight)"
      stroke-width="1.5"
      vector-effect="non-scaling-stroke"
      class="draw-line"
      style="--len: 520"
    />
    <path
      d="M0,192 C15,190 25,182 40,152 C50,132 60,102 75,97 C110,92 150,94 200,90 C240,88 270,97 310,122 C340,142 360,162 380,172 L400,176"
      fill="none"
      stroke="var(--color-flow)"
      stroke-width="1.5"
      vector-effect="non-scaling-stroke"
      class="draw-line draw-line-delayed"
      style="--len: 520"
    />
  </svg>

  <div class="relative z-10 w-full max-w-6xl mx-auto px-6">
    <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-14 lg:gap-12 items-center">
      <!-- Text -->
      <div class="text-center lg:text-left">
        <p class="label mb-5 animate">Siebträger · Lokal · Ohne Account</p>

        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl leading-[1.1] text-balance mb-6">
          Espresso einstellen,<br class="hidden sm:block" />
          <span class="text-accent">ohne zu raten.</span>
        </h1>

        <p class="text-lg text-ink-2 max-w-xl mx-auto lg:mx-0 mb-9 leading-relaxed">
          BrewMind nimmt jeden Shot auf, live über die Bluetooth-Waage oder
          per Timer, und merkt sich pro Bohne, was funktioniert hat. Vor dem
          nächsten Shot steht ein Vorschlag: ein Hebel, ein Satz. Damit die
          nächste Tüte nicht wieder 500 g Einstellkaffee kostet.
        </p>

        <!--
          Der erste Knopf ist die Beta, nicht der App Store: die App ist noch
          nicht drin, und wer hier landet, soll testen koennen, ohne bis ans
          Seitenende zu scrollen.
        -->
        <div class="flex flex-col sm:flex-row items-center lg:justify-start justify-center gap-4 mb-5">
          <a
            href={TESTFLIGHT_URL}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-accent text-on-accent text-sm font-semibold hover:bg-accent-pressed transition-colors"
          >
            Beta auf dem iPhone testen
          </a>

          <a
            href="#android"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl border border-accent/40 text-accent text-sm font-semibold hover:bg-accent/10 transition-colors"
          >
            Beta auf Android testen
          </a>

        </div>

        <p class="text-sm text-ink-3 mb-10 animate">
          Kostenlose Beta für iPhone (TestFlight) und Android (Google Play), ohne Warteliste.
        </p>

        <a href="#features" class="inline-flex items-center gap-2 text-sm font-medium text-accent hover:text-accent-pressed transition-colors animate">
          Was die App kann &darr;
        </a>
      </div>

      <!-- Geraet -->
      <div class="relative mx-auto w-full max-w-[280px] sm:max-w-[300px]">
        <div class="aspect-[9/19.5] rounded-[2.75rem] border-[10px] border-surface-2 bg-surface overflow-hidden glow-accent">
          <Image
            src={cockpit}
            alt="Das Bohnen-Cockpit von BrewMind: aktive Bohne, Tag nach Röstung und die zuletzt gefahrene Einstellung"
            width={780}
            format="webp"
            loading="eager"
            fetchpriority="high"
            class="w-full h-full object-cover object-top"
          />
        </div>
      </div>
    </div>
  </div>
</section>
