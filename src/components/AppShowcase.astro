---
import { Image, getImage } from 'astro:assets';
import vorschlag from '../assets/screens/vorschlag.png';
import shotLive from '../assets/screens/shot-live.png';
import shotAbschluss from '../assets/screens/shot-abschluss.png';
import history from '../assets/screens/history.png';
import shotDetail from '../assets/screens/shot-detail.png';

const shots = [
  {
    src: vorschlag,
    alt: 'Vorbereitungs-Screen mit dem Coach-Vorschlag „Mahlgrad 0,3 gröber“ und einem Knopf zum Übernehmen am Mahlgrad-Stepper',
    caption: 'Vorbereitung: ein Hebel, ein Satz, ein Tippen zum Übernehmen',
  },
  {
    src: shotLive,
    alt: 'Aufnahme-Screen mit Zeit ab Pumpenstart, Live-Gewicht und Fortschritt zum Ziel-Yield',
    caption: 'Aufnahme: Zeit ab Pumpenstart, Gewicht, Ziel-Fortschritt',
  },
  {
    src: shotAbschluss,
    alt: 'Abschluss-Screen: 27,5 s im Zielband, Diagnose „Getroffen“ und nächster Schritt „Alles so lassen“',
    caption: 'Abschluss: Zeit im Zielband, Diagnose, nächster Schritt',
  },
  {
    src: history,
    alt: 'History-Liste, nach Bohne und Getränk gruppiert, mit Bestwert je Getränk',
    caption: 'History: nach Bohne und Getränk, Bestwert vorne',
  },
  {
    src: shotDetail,
    alt: 'Shot-Detail mit Stift zum Bearbeiten, Geschmack, Kennzahlen, Gewichts- und Flow-Kurve, First Drip und Pumpenstopp markiert',
    caption: 'Detail: Gewichts- und Flow-Kurve, First Drip, Pumpenstopp',
  },
];

// Grossbild fuer die Lightbox: volle Aufnahmebreite, als webp.
const gross = await Promise.all(
  shots.map((shot) => getImage({ src: shot.src, width: 1320, format: 'webp' })),
);
---

<section id="app" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="max-w-2xl mb-12">
      <p class="label mb-4 animate">Ein Blick hinein</p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl leading-tight text-balance mb-5 animate">
        Zahlen sind der Inhalt.
      </h2>
      <p class="text-ink-2 leading-relaxed animate">
        Dunkel, warm und ruhig, damit um sechs Uhr morgens die Ziffern
        auffallen und nicht das Interface.
      </p>
    </div>

    <!-- Mobil als Snap-Reihe, ab Desktop als Raster -->
    <div class="flex md:grid md:grid-cols-3 lg:grid-cols-5 gap-5 overflow-x-auto md:overflow-visible snap-x snap-mandatory pb-4 md:pb-0 -mx-6 px-6 md:mx-0 md:px-0">
      {shots.map((shot, i) => (
        <figure class={`animate stagger-${(i % 4) + 1} shrink-0 w-[70vw] sm:w-[45vw] md:w-auto snap-center m-0`}>
          <button
            type="button"
            class="screen-oeffnen group block w-full rounded-2xl border border-border overflow-hidden bg-bg-deep cursor-zoom-in transition-colors hover:border-accent focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2"
            data-index={i}
            aria-label={`Screen vergrößern: ${shot.caption}`}
          >
            <!-- Seitenverhaeltnis der Aufnahme (1320x2868, iPhone 17 Pro Max): der Screen bleibt ganz. -->
            <div class="relative aspect-[1320/2868] overflow-hidden">
              <Image
                src={shot.src}
                alt={shot.alt}
                width={640}
                densities={[1, 2]}
                format="webp"
                class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.02]"
              />
            </div>
          </button>
          <figcaption class="mt-3 text-sm text-ink-3 leading-relaxed">
            {shot.caption}
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="mt-6 text-sm text-ink-3">Zum Vergrößern auf einen Screen tippen.</p>
  </div>

  <!-- Lightbox: ein Screen gross, Pfeile, Tasten und Wischen blaettern, Esc oder Klick daneben schliesst. -->
  <dialog id="screen-lightbox" class="lightbox" aria-label="Screens der App">
    <div class="lightbox-buehne">
      <button type="button" class="lightbox-knopf lightbox-zu" data-aktion="zu" aria-label="Schließen">✕</button>
      <button type="button" class="lightbox-knopf lightbox-zurueck" data-aktion="zurueck" aria-label="Vorheriger Screen">‹</button>
      <figure class="lightbox-figur">
        <img class="lightbox-bild" src={gross[0].src} alt={shots[0].alt} width="1320" height="2868" />
        <figcaption class="lightbox-text">
          <span class="lightbox-zaehler">1 / {shots.length}</span>
          <span class="lightbox-titel">{shots[0].caption}</span>
        </figcaption>
      </figure>
      <button type="button" class="lightbox-knopf lightbox-weiter" data-aktion="weiter" aria-label="Nächster Screen">›</button>
    </div>
  </dialog>
  <script
    type="application/json"
    id="screen-daten"
    set:html={JSON.stringify(shots.map((shot, i) => ({ src: gross[i].src, alt: shot.alt, caption: shot.caption })))}
  />
</section>

<script>
  type Screen = { src: string; alt: string; caption: string };

  const dialog = document.getElementById('screen-lightbox') as HTMLDialogElement | null;
  const datenEl = document.getElementById('screen-daten');
  if (dialog && datenEl) {
    const screens: Screen[] = JSON.parse(datenEl.textContent ?? '[]');
    const bild = dialog.querySelector<HTMLImageElement>('.lightbox-bild')!;
    const zaehler = dialog.querySelector<HTMLElement>('.lightbox-zaehler')!;
    const titel = dialog.querySelector<HTMLElement>('.lightbox-titel')!;
    let aktuell = 0;

    const zeige = (i: number) => {
      aktuell = (i + screens.length) % screens.length;
      const s = screens[aktuell];
      bild.src = s.src;
      bild.alt = s.alt;
      zaehler.textContent = `${aktuell + 1} / ${screens.length}`;
      titel.textContent = s.caption;
      // Nachbarn vorladen, damit Blaettern ohne Wartezeit geht
      [aktuell - 1, aktuell + 1].forEach((n) => {
        new Image().src = screens[(n + screens.length) % screens.length].src;
      });
    };

    document.querySelectorAll<HTMLButtonElement>('.screen-oeffnen').forEach((knopf) => {
      knopf.addEventListener('click', () => {
        zeige(Number(knopf.dataset.index));
        dialog.showModal();
        document.documentElement.classList.add('lightbox-offen');
      });
    });

    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('lightbox-offen');
    });

    dialog.addEventListener('click', (e) => {
      const ziel = e.target as HTMLElement;
      const aktion = ziel.closest<HTMLElement>('[data-aktion]')?.dataset.aktion;
      if (aktion === 'zu') dialog.close();
      else if (aktion === 'zurueck') zeige(aktuell - 1);
      else if (aktion === 'weiter') zeige(aktuell + 1);
      // Klick neben das Bild schliesst
      else if (ziel === dialog || ziel.classList.contains('lightbox-buehne')) dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') zeige(aktuell - 1);
      else if (e.key === 'ArrowRight') zeige(aktuell + 1);
    });

    // Wischen auf dem Handy
    let startX: number | null = null;
    dialog.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      if (startX === null) return;
      const dx = e.changedTouches[0].clientX - startX;
      startX = null;
      if (Math.abs(dx) > 50) zeige(aktuell + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
  }
  .lightbox::backdrop {
    background: rgb(18 13 11 / 0.92);
    backdrop-filter: blur(6px);
  }
  .lightbox[open] {
    animation: lightbox-ein 180ms ease-out;
  }
  @keyframes lightbox-ein {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .lightbox-buehne {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    width: 100%;
    height: 100%;
    padding: 3.5rem 1rem 1.5rem;
  }
  .lightbox-figur {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    height: 100%;
    min-width: 0;
  }
  .lightbox-bild {
    flex: 1 1 auto;
    min-height: 0;
    width: auto;
    max-width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 1.25rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg-deep);
  }
  .lightbox-text {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.875rem;
    color: var(--color-ink-2);
    text-align: center;
  }
  .lightbox-zaehler {
    color: var(--color-ink-3);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .lightbox-knopf {
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color 150ms, color 150ms;
  }
  .lightbox-knopf:hover,
  .lightbox-knopf:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
    outline: none;
  }
  .lightbox-zu {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.1rem;
  }
  /* Handy: Pfeile links und rechts neben den Bildtext, Wischen ist der Hauptweg */
  @media (max-width: 640px) {
    .lightbox-buehne {
      padding-bottom: 0.75rem;
    }
    .lightbox-text {
      flex-direction: column;
      align-items: center;
      gap: 0.125rem;
      min-height: 2.75rem;
      padding: 0 3.5rem;
    }
    .lightbox-zurueck,
    .lightbox-weiter {
      position: absolute;
      bottom: 0.75rem;
      width: 2.75rem;
      height: 2.75rem;
    }
    .lightbox-zurueck { left: 0.75rem; }
    .lightbox-weiter { right: 0.75rem; }
  }
  :global(html.lightbox-offen) {
    overflow: hidden;
  }
</style>
