---
import { createHash } from 'node:crypto';
import { transformWithEsbuild } from 'vite';
import regelQuelle from '../../lib/apple-rueckweg.ts?raw';

/**
 * Rückweg von „Mit Apple anmelden“ auf Android (BrewMind/brewmind-core#1020).
 * Apple leitet nach der Anmeldung im Browser hierher, mit dem Ergebnis im
 * Fragment der Adresse. Die Seite reicht es an die App weiter (Regel und Tests
 * in `src/lib/apple-rueckweg.ts`) und tut sonst nichts.
 *
 * Bewusst ohne das Layout der Website: eigenes, nacktes Gerüst, Stil und
 * Skript stehen in der Seite selbst. So lädt sie außer dem Signet nichts nach,
 * und die Content-Security-Policy kann alles andere verbieten. Die Hashes in
 * der Policy rechnet der Build aus genau dem Text, der in der Seite landet.
 *
 * Das Token steht nur im Speicher: nie im DOM, nie in der Adresse, nichts wird
 * gespeichert oder protokolliert. noindex und nicht in der Sitemap (siehe
 * astro.config.mjs). Die Adresse ist bei Apple als Return URL eingetragen,
 * also nicht umbenennen.
 */

// Die Regel ist TypeScript, der Browser bekommt sie ohne Typen. Dieselbe Datei prüft vitest.
const regel = (await transformWithEsbuild(regelQuelle, 'apple-rueckweg.ts', { loader: 'ts', format: 'esm' })).code;

const start = `
const ergebnis = leseRueckweg(location.hash);
// Erst das Fragment aus Adresse und Verlauf nehmen, dann weiter
history.replaceState(null, '', location.pathname);
if (ergebnis.art === 'weiter') {
  const ziel = ergebnis.ziel;
  document.getElementById('zurueck').addEventListener('click', () => {
    location.href = ziel;
  });
  document.getElementById('weiter').hidden = false;
  location.replace(ziel);
} else {
  document.getElementById('hinweis').hidden = false;
}
`;
const skript = `${regel}\n${start}`;

const stil = `
*{box-sizing:border-box}
html{color-scheme:dark}
body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;background:#181210;color:#F4EDE4;font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;-webkit-font-smoothing:antialiased}
main{width:100%;max-width:26rem;text-align:center}
[hidden]{display:none!important}
.marke{display:flex;align-items:center;justify-content:center;gap:12px;margin-bottom:40px;font-size:1.125rem;font-weight:600}
h1{font-family:Georgia,'Times New Roman',serif;font-weight:400;font-size:1.75rem;line-height:1.2;margin:0 0 12px}
p{margin:0;color:#CBBBA8;font-size:1rem;line-height:1.6}
button{margin-top:28px;padding:14px 24px;border:0;border-radius:12px;background:#E0A458;color:#2A1B08;font:inherit;font-size:.875rem;font-weight:600;cursor:pointer}
button:hover,button:active{background:#C98F45}
button:focus-visible{outline:2px solid #F4EDE4;outline-offset:3px}
.klein{margin-top:16px;color:#9C8B79;font-size:.875rem}
`;

const hash = (text: string) => `'sha256-${createHash('sha256').update(text, 'utf8').digest('base64')}'`;
const csp = [
  "default-src 'none'",
  `script-src ${hash(skript)}`,
  `style-src ${hash(stil)}`,
  "img-src 'self'",
  "base-uri 'none'",
  "form-action 'none'",
].join('; ');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#181210" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Anmeldung | BrewMind</title>
    <style is:inline set:html={stil} />
  </head>
  <body>
    <main>
      <div class="marke">
        <img src="/logo-mark.svg" width="32" height="32" alt="" />
        <span>BrewMind</span>
      </div>

      <noscript>
        <h1>Ohne JavaScript geht es nicht</h1>
        <p>
          Die Anmeldung mit Apple braucht JavaScript, um dich zurück in die App
          zu bringen. Schalte es ein und starte die Anmeldung in der App neu.
        </p>
      </noscript>

      <section id="weiter" hidden>
        <h1>Fast geschafft</h1>
        <p>Du wirst zurück in die App geleitet.</p>
        <button id="zurueck" type="button">Zurück zu BrewMind</button>
        <p class="klein">Tippe auf den Knopf, falls sich die App nicht von selbst öffnet.</p>
      </section>

      <section id="hinweis" hidden>
        <h1>Anmeldung in der App</h1>
        <p>
          Diese Seite gehört zur Anmeldung in der BrewMind-App. Bitte starte die
          Anmeldung in der App neu.
        </p>
      </section>
    </main>
    <script is:inline type="module" set:html={skript} />
  </body>
</html>
