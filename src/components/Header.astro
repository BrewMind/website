---
---

<header class="fixed top-0 left-0 right-0 z-[60] backdrop-blur-md bg-bg/80 border-b border-border">
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <!--
        Signet inline statt als <img>, damit der Schnitt beim Hover neu
        gezeichnet werden kann: erst der volle Zielkreis, dann laeuft der Shot
        hindurch und laesst die Bohne stehen. Ruhezustand ist die fertige Bohne.
      -->
      <svg class="w-8 h-8" viewBox="0 0 100 100" width="32" height="32" role="img" aria-label="BrewMind">
        <mask id="header-mark-cut">
          <circle cx="50" cy="50" r="36" fill="#fff" />
          <path
            class="logo-cut"
            d="M10,76 C28,75 34,68 44,55 C54,42 64,28 90,26"
            fill="none"
            stroke="#000"
            stroke-width="12"
            stroke-linecap="butt"
          />
        </mask>
        <rect width="100" height="100" fill="var(--color-accent)" mask="url(#header-mark-cut)" />
      </svg>
      <span class="text-lg font-semibold text-ink">BrewMind</span>
    </a>

    <!-- Navigation -->
    <div class="hidden md:flex items-center gap-8">
      <a href="/#features" class="text-sm text-ink-2 hover:text-ink transition-colors">Funktionen</a>
      <a href="/#how-it-works" class="text-sm text-ink-2 hover:text-ink transition-colors">Ablauf</a>
      <a href="/#app" class="text-sm text-ink-2 hover:text-ink transition-colors">Screens</a>
    </div>

    <!-- CTA -->
    <a href="/#beta" class="hidden md:inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent/10 text-accent text-sm font-medium hover:bg-accent/20 transition-colors">
      Beta
    </a>

    <!-- Hamburger Button (mobile only) -->
    <button
      id="menu-toggle"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="flex md:hidden items-center justify-center w-11 h-11 rounded-lg
             text-ink-2 hover:text-ink hover:bg-surface transition-colors"
    >
      <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>
</header>

<!-- Fullscreen Overlay (outside header to avoid stacking context issues with backdrop-blur) -->
<div
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation"
  class="fixed inset-0 z-50 flex flex-col items-center justify-center
         bg-bg/95 backdrop-blur-md
         opacity-0 pointer-events-none invisible
         transition-opacity duration-200"
>
  <nav class="flex flex-col items-center gap-8">
    <a href="/#features" class="text-2xl font-semibold text-ink mobile-nav-link">Funktionen</a>
    <a href="/#how-it-works" class="text-2xl font-semibold text-ink mobile-nav-link">Ablauf</a>
    <a href="/#app" class="text-2xl font-semibold text-ink mobile-nav-link">Screens</a>
    <a href="/#beta" class="text-2xl font-semibold text-accent mobile-nav-link">Beta</a>
  </nav>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const navLinks = menu?.querySelectorAll('.mobile-nav-link');

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReducedMotion && menu) {
    menu.classList.remove('transition-opacity', 'duration-200');
  }

  let isOpen = false;

  function openMenu() {
    isOpen = true;
    menu?.classList.remove('opacity-0', 'pointer-events-none', 'invisible');
    menu?.classList.add('opacity-100');
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.setAttribute('aria-label', 'Menü schließen');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    // Focus first link
    const firstLink = menu?.querySelector('.mobile-nav-link');
    if (firstLink instanceof HTMLElement) firstLink.focus();
  }

  function closeMenu() {
    isOpen = false;
    menu?.classList.add('opacity-0', 'pointer-events-none');
    menu?.classList.remove('opacity-100');
    // Add invisible after fade-out transition (or immediately if reduced-motion)
    if (prefersReducedMotion) {
      menu?.classList.add('invisible');
    } else {
      menu?.addEventListener('transitionend', () => {
        if (!isOpen) menu?.classList.add('invisible');
      }, { once: true });
    }
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Menü öffnen');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    document.body.style.overflow = '';
    toggle?.focus();
  }

  // Toggle
  toggle?.addEventListener('click', () => isOpen ? closeMenu() : openMenu());

  // Close on nav link click
  navLinks?.forEach(link => link.addEventListener('click', closeMenu));

  // Backdrop click (click on overlay but not on nav)
  menu?.addEventListener('click', (e) => {
    if (e.target === menu) closeMenu();
  });

  // Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) closeMenu();
  });

  // Resize guard: close when viewport becomes desktop
  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches && isOpen) closeMenu();
  });

  // Focus trap
  menu?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || !isOpen) return;
    const focusable = menu.querySelectorAll('a, button, [tabindex]:not([tabindex="-1"])');
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      if (last instanceof HTMLElement) last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      if (first instanceof HTMLElement) first.focus();
    }
  });
</script>

<style>
  /* Pfadlaenge der Kurve: 98,32 — auf 99 aufgerundet. */
  .logo-cut {
    stroke-dasharray: 99;
    stroke-dashoffset: 0;
  }

  .group:hover .logo-cut {
    animation: logo-draw 0.9s cubic-bezier(0.22, 0.9, 0.3, 1) both;
  }

  @keyframes logo-draw {
    from {
      stroke-dashoffset: 99;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .group:hover .logo-cut {
      animation: none;
    }
  }
</style>
