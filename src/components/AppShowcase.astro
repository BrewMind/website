---
import { Image } from 'astro:assets';
import coachArmed from '../assets/screens/coach_armed_default.png';
import dialInJourney from '../assets/screens/dial_in_journey.png';
import ratingTasteCompass from '../assets/screens/rating_taste_compass.png';
import historyTrend from '../assets/screens/history_trend.png';

const shots = [
  {
    src: coachArmed,
    alt: 'Coach-Screen mit einem hervorgehobenen Bruehparameter',
    caption: 'Der Coach: ein Parameter pro Shot',
  },
  {
    src: dialInJourney,
    alt: 'Dial-In-Verlauf der sich dem Sweet-Spot annaehert',
    caption: 'Deine Konvergenz zum Sweet-Spot',
  },
  {
    src: ratingTasteCompass,
    alt: 'Geschmackskompass zur Shot-Bewertung',
    caption: 'Geschmack per Kompass bewerten',
  },
  {
    src: historyTrend,
    alt: 'Trend-Chart der letzten Shots ueber zwei Wochen',
    caption: 'Trends über 14 Tage',
  },
];
---

<section id="app" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-16">
      <p class="font-data uppercase tracking-widest text-sm text-text-muted mb-3 animate">
        Ein Blick in die App
      </p>
      <h2 class="font-display text-3xl sm:text-4xl font-bold mb-4 animate">
        So fühlt sich BrewMind an.
      </h2>
      <p class="text-text-secondary max-w-xl mx-auto animate">
        Vom ersten Setup bis zum Trend über Wochen — jeder Screen zeigt dir genau,
        was gerade zählt.
      </p>
    </div>

    <!-- Mobile: horizontal snap scroll — Desktop: grid -->
    <div
      class="flex md:grid md:grid-cols-4 gap-6 overflow-x-auto md:overflow-visible snap-x snap-mandatory pb-4 md:pb-0 -mx-6 px-6 md:mx-0 md:px-0"
    >
      {shots.map((shot, i) => (
        <div class={`animate stagger-${i + 1} shrink-0 w-[70vw] sm:w-[45vw] md:w-auto snap-center`}>
          <div class="rounded-2xl border border-surface-light overflow-hidden bg-bg-alt">
            <div class="relative aspect-[9/14] overflow-hidden">
              <Image
                src={shot.src}
                alt={shot.alt}
                width={640}
                format="webp"
                class="absolute inset-0 w-full h-full object-cover object-top"
              />
            </div>
          </div>
          <p class="mt-3 text-sm text-text-secondary text-center md:text-left">
            {shot.caption}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
