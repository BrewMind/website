---
/**
 * Die Beta laeuft ueber einen oeffentlichen TestFlight-Link, nicht mehr ueber
 * eine E-Mail an mich. Jeder Kanal hat einen eigenen Link, damit App Store
 * Connect zaehlen kann, woher die Tester kommen; dieser hier gehoert der
 * Website und darf nirgends sonst auftauchen. Liste aller Links:
 * brewmind-core/socials/beta-links.md
 *
 * Kein Formular: die Seite bleibt statisch und nimmt keine Daten entgegen.
 */
const testflight = 'https://testflight.apple.com/join/9VptC31s';
---

<section id="beta" class="py-24 px-6">
  <div class="max-w-3xl mx-auto text-center">
    <p class="label mb-4 animate">Stand heute</p>

    <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl leading-tight text-balance mb-5 animate">
      Noch nicht im App Store.
    </h2>

    <p class="text-lg text-ink-2 leading-relaxed mb-9 max-w-xl mx-auto animate">
      BrewMind läuft als offene Beta über TestFlight, auf dem iPhone, mit
      einer Bluetooth-Waage oder ohne. Du brauchst Apples TestFlight-App,
      danach bist du direkt drin. Keine Warteliste, keine Anmeldung bei mir.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate">
      <a
        href={testflight}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-accent text-on-accent text-sm font-semibold hover:bg-accent-pressed transition-colors"
      >
        Beta über TestFlight öffnen
      </a>
      <a
        href="/datenschutz"
        class="text-sm text-ink-3 hover:text-ink-2 transition-colors"
      >
        Was mit deinen Daten passiert
      </a>
    </div>
  </div>
</section>
