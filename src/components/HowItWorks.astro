---
const steps = [
  {
    number: '01',
    meta: 'Einmalig',
    title: 'Anlegen, was auf dem Tisch steht',
    description:
      'Bohne, Maschine, Mühle, auf Wunsch die Bluetooth-Waage. Danach kein Pflicht-Setup mehr, nachpflegen geht jederzeit in der Verwaltung.',
  },
  {
    number: '02',
    meta: 'Rund drei Taps',
    title: 'Shot ziehen',
    description:
      'Dosis, Mahlgrad, Temperatur und Ziel-Yield stehen aus dem letzten Mal vorausgefüllt da. Ein Tap beim Pumpenstart, dann läuft die Aufnahme: mit Waage live, ohne Waage als Timer.',
  },
  {
    number: '03',
    meta: 'Rund zehn Sekunden',
    title: 'Bewerten und weglegen',
    description:
      'Zeit, Yield, Ratio und Peak-Flow groß, dazu das Delta zum letzten Shot derselben Bohne. Geschmacksurteil per Tap auf einen Chip, speichern, fertig.',
  },
];
---

<section id="how-it-works" class="py-24 px-6 bg-bg-deep border-y border-border">
  <div class="max-w-6xl mx-auto">
    <div class="max-w-2xl mb-14">
      <p class="label mb-4 animate">Der Ablauf</p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl leading-tight text-balance mb-5 animate">
        Vom Öffnen bis zum gespeicherten Shot.
      </h2>
      <p class="text-ink-2 leading-relaxed animate">
        Der Weg zum Shot ist die eine Strecke, die kurz bleiben muss. Alles
        andere in der App darf warten.
      </p>
    </div>

    <ol class="grid md:grid-cols-3 gap-10 md:gap-8">
      {steps.map((step, i) => (
        <li class={`relative animate stagger-${i + 1}`}>
          <div class="flex items-baseline gap-4 mb-5">
            <span class="tabular text-4xl font-medium text-ink-3/50">{step.number}</span>
            <span class="label">{step.meta}</span>
          </div>

          <div class="h-px bg-border mb-5" aria-hidden="true"></div>

          <h3 class="text-xl font-semibold text-ink mb-3 text-balance">{step.title}</h3>
          <p class="text-ink-2 leading-relaxed">{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
