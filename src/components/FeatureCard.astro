---
interface Props {
  title: string;
  description: string;
  /**
   * Bernstein ist die Akzentfarbe der Marke. Blau steht ausschliesslich fuer
   * die Flow-Serie — dieselbe Zuordnung wie im Shot-Detail der App, damit die
   * Farbe eine Bedeutung behaelt und nicht zur Dekoration wird.
   */
  tone?: 'accent' | 'flow';
}

const { title, description, tone = 'accent' } = Astro.props;

const tones = {
  accent: { icon: 'text-accent', wash: 'bg-accent/10' },
  flow: { icon: 'text-flow', wash: 'bg-flow/10' },
};

const t = tones[tone];
---

<article class="group h-full rounded-2xl bg-surface border border-border p-6 transition-colors duration-300 hover:border-accent/35">
  <div class={`w-11 h-11 rounded-xl ${t.wash} ${t.icon} flex items-center justify-center mb-5`}>
    <slot name="icon" />
  </div>

  <h3 class="text-lg font-semibold text-ink mb-2 text-balance">{title}</h3>
  <p class="text-sm text-ink-2 leading-relaxed">{description}</p>
</article>
